[Defines]
  INF_VERSION = 0x0001001B
  BASE_NAME = UkeEspProbe
  FILE_GUID = 74a1fb7f-502c-4f14-b964-a026f15806a8
  MODULE_TYPE = UEFI_APPLICATION
  VERSION_STRING = 0.1.0
  ENTRY_POINT = UkeProbeEntry

[Sources]
  EspProbe.c
  ../core/gpt.c

[Packages]
  MdePkg/MdePkg.dec
  UkeBootCorePkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint

[Protocols]
  gEfiBlockIoProtocolGuid

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -DUKE_EDK2
  MSFT:*_*_*_CC_FLAGS = /DUKE_EDK2
