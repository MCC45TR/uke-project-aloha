[Defines]
  INF_VERSION = 0x0001001B
  BASE_NAME = UkeBootDispatcher
  FILE_GUID = c258b112-cd57-48b1-9eb7-31f15d49c4e6
  MODULE_TYPE = UEFI_APPLICATION
